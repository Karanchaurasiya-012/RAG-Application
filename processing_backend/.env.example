# Copy to .env and fill real values. Never commit .env.
#
# Docker Compose (Phase 18):
#   docker compose up --build -d
#   Health: curl http://127.0.0.1:8081/api/v1/health
# Compose overrides DB_URL to jdbc:postgresql://postgres:5432/document_db
# and mounts ./keys/public.pem at /app/keys/public.pem.
# Host DB port mapping is 5437 (see docker-compose.yml).

SERVER_PORT=8081

# Database (Document Processing Service owns document_db)
DB_URL=jdbc:postgresql://localhost:5432/document_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT — verify tokens issued by AuthBackend (public key only)
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=auth-api
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# AWS S3 — original PDFs (private bucket)
AWS_REGION=ap-south-1
S3_BUCKET=file-upload-s3-demo-2026
# Prefer AWS_PROFILE or IAM role in prod. Local:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Embedding — frontend may choose per upload; default is ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=1024

# Local jar: localhost. Compose default: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# PDF limits
MAX_PDF_SIZE_MB=20
MAX_PDF_PAGES=200

# Chunking (initial)
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Local temp storage before S3 (Phase 9)
LOCAL_TEMP_DIR=./tmp/uploads
S3_DOWNLOAD_URL_EXPIRY_SECONDS=300

# Async jobs (Phase 14)
JOB_CONCURRENCY=2
JOB_QUEUE_CAPACITY=50
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=5000
JOB_POLL_INTERVAL_MS=1000

# Frontend origin for cookie-authenticated browser calls
CORS_ORIGIN=http://localhost:3000
