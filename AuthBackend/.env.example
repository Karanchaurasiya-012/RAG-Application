# Copy to .env and fill real values. Never commit .env.

# Host run (./mvnw spring-boot:run) against local Postgres:
DB_URL=jdbc:postgresql://localhost:5432/auth_db
# Docker Compose overrides backend DB_URL to:
# jdbc:postgresql://postgres:5432/auth_db
# Host tools talking to Docker Postgres use localhost:5433
DB_USERNAME=postgres
DB_PASSWORD=change-me


GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080

JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=auth-api
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_TOKEN_TTL=7d

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h

