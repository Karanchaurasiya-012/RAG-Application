# Example values when using docker compose.
# Copy ideas into your local .env — do not commit real secrets.
#
# Host tools (DBeaver etc.) connect to Docker Postgres at:
#   localhost:5433
# Backend container connects internally at:
#   postgres:5432  (set automatically by docker-compose.yml)

DB_USERNAME=postgres
DB_PASSWORD=change-me

# Override applied by compose for the backend service:
# DB_URL=jdbc:postgresql://postgres:5432/auth_db

FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080

JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=auth-api
# Compose mounts ./keys and overrides paths to:
# JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
# JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
